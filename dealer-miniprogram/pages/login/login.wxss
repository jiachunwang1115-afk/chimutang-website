.login-page { min-height: 100vh; background: #fbf8f2; }
.login-image { display: block; width: 100%; height: 34vh; min-height: 310rpx; }
.login-panel { min-height: 66vh; padding: 40rpx 42rpx calc(40rpx + env(safe-area-inset-bottom)); }
.login-brand { display: flex; align-items: center; gap: 18rpx; margin-bottom: 48rpx; color: #75685e; font-size: 18rpx; letter-spacing: 3rpx; }
.login-brand image { width: 92rpx; height: 72rpx; }
.login-title { display: block; margin-top: 18rpx; font-family: STSong, SimSun, serif; font-size: 58rpx; font-weight: 600; }
.login-copy { display: block; margin-top: 20rpx; color: #75685e; font-size: 23rpx; line-height: 1.7; }
.login-form { margin-top: 44rpx; }
.login-form .primary-button { margin-top: 36rpx; }
.change-title { display: block; margin-bottom: 20rpx; font-size: 29rpx; font-weight: 700; }
.login-message { display: block; min-height: 40rpx; margin-top: 22rpx; color: #9a352d; font-size: 21rpx; }
.login-support { display: block; margin-top: 42rpx; color: #75685e; font-size: 19rpx; }
