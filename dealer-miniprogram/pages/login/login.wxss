.login-page { width: 100%; min-height: 100vh; background: #fbf8f2; overflow-x: hidden; }
.login-image { display: block; width: 100%; height: 23vh; min-height: 220rpx; max-height: 330rpx; }
.login-panel { width: 100%; min-height: 77vh; padding: 26rpx 28rpx calc(32rpx + env(safe-area-inset-bottom)); }
.login-brand { display: flex; min-width: 0; align-items: center; gap: 14rpx; margin-bottom: 22rpx; color: #75685e; font-size: 16rpx; letter-spacing: 0; }
.login-brand image { width: 82rpx; height: 64rpx; }
.login-title { display: block; margin-top: 12rpx; font-family: STSong, SimSun, serif; font-size: 44rpx; font-weight: 600; line-height: 1.2; }
.login-copy { display: block; margin-top: 12rpx; color: #75685e; font-size: 21rpx; line-height: 1.55; }
.login-form { width: 100%; margin-top: 26rpx; }
.login-step { display: flex; align-items: baseline; gap: 18rpx; margin-bottom: 8rpx; }
.login-step text:first-child { color: #9a6741; font-family: Georgia, serif; font-size: 21rpx; }
.login-step text:last-child { font-size: 25rpx; font-weight: 700; }
.demo-notice { display: grid; gap: 6rpx; margin: 18rpx 0 6rpx; padding: 14rpx 16rpx; border-left: 3rpx solid #9a6741; background: #f1eee9; color: #75685e; font-size: 18rpx; line-height: 1.5; }
.demo-notice text:first-child { flex: none; color: #5c3524; font-weight: 700; }
.login-form > button { width: 100%; margin-right: 0; margin-left: 0; }
.login-form .primary-button { margin-top: 28rpx; }
.login-message { display: block; min-height: 36rpx; margin-top: 18rpx; color: #9a352d; font-size: 19rpx; line-height: 1.55; }
.login-support { display: block; margin-top: 26rpx; color: #75685e; font-size: 18rpx; }

@media (max-width: 360px) {
  .login-panel { padding-right: 24rpx; padding-left: 24rpx; }
  .login-title { font-size: 46rpx; }
}
