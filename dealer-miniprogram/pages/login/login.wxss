.login-page { min-height: 100vh; background: #fbf8f2; }
.login-image { display: block; width: 100%; height: 31vh; min-height: 280rpx; max-height: 440rpx; }
.login-panel { min-height: 69vh; padding: 36rpx 42rpx calc(42rpx + env(safe-area-inset-bottom)); }
.login-brand { display: flex; align-items: center; gap: 18rpx; margin-bottom: 40rpx; color: #75685e; font-size: 18rpx; letter-spacing: 3rpx; }
.login-brand image { width: 92rpx; height: 72rpx; }
.login-title { display: block; margin-top: 16rpx; font-family: STSong, SimSun, serif; font-size: 56rpx; font-weight: 600; }
.login-copy { display: block; margin-top: 18rpx; color: #75685e; font-size: 23rpx; line-height: 1.7; }
.login-form { margin-top: 38rpx; }
.login-step { display: flex; align-items: baseline; gap: 18rpx; margin-bottom: 8rpx; }
.login-step text:first-child { color: #9a6741; font-family: Georgia, serif; font-size: 21rpx; }
.login-step text:last-child { font-size: 28rpx; font-weight: 700; }
.login-form > button { width: 100%; margin-right: 0; margin-left: 0; }
.login-form .primary-button { margin-top: 34rpx; }
.preview-button { min-height: 82rpx; margin-top: 16rpx; border: 1rpx solid #c8b8a8; border-radius: 6rpx; background: transparent; color: #5b3928; font-size: 24rpx; font-weight: 700; line-height: 82rpx; }
.preview-note { display: block; margin-top: 14rpx; color: #75685e; font-size: 19rpx; line-height: 1.6; text-align: center; }
.login-message { display: block; min-height: 40rpx; margin-top: 22rpx; color: #9a352d; font-size: 21rpx; line-height: 1.6; }
.login-support { display: block; margin-top: 34rpx; color: #75685e; font-size: 19rpx; }
