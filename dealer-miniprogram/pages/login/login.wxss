.login-page { width: 100%; min-height: 100vh; background: #fbf8f2; overflow-x: hidden; }
.login-image { display: block; width: 100%; height: 27vh; min-height: 250rpx; max-height: 380rpx; }
.login-panel { width: 100%; min-height: 73vh; padding: 32rpx 32rpx calc(38rpx + env(safe-area-inset-bottom)); }
.login-brand { display: flex; min-width: 0; align-items: center; gap: 16rpx; margin-bottom: 30rpx; color: #75685e; font-size: 17rpx; letter-spacing: 2rpx; }
.login-brand image { width: 92rpx; height: 72rpx; }
.login-title { display: block; margin-top: 16rpx; font-family: STSong, SimSun, serif; font-size: 50rpx; font-weight: 600; line-height: 1.2; }
.login-copy { display: block; margin-top: 18rpx; color: #75685e; font-size: 23rpx; line-height: 1.7; }
.login-form { width: 100%; margin-top: 32rpx; }
.login-step { display: flex; align-items: baseline; gap: 18rpx; margin-bottom: 8rpx; }
.login-step text:first-child { color: #9a6741; font-family: Georgia, serif; font-size: 21rpx; }
.login-step text:last-child { font-size: 28rpx; font-weight: 700; }
.demo-notice { display: grid; gap: 8rpx; margin: 22rpx 0 8rpx; padding: 18rpx 20rpx; border-left: 4rpx solid #9a6741; background: #f1e9df; color: #75685e; font-size: 19rpx; line-height: 1.55; }
.demo-notice text:first-child { flex: none; color: #5c3524; font-weight: 700; }
.login-form > button { width: 100%; margin-right: 0; margin-left: 0; }
.login-form .primary-button { margin-top: 34rpx; }
.login-message { display: block; min-height: 40rpx; margin-top: 22rpx; color: #9a352d; font-size: 21rpx; line-height: 1.6; }
.login-support { display: block; margin-top: 34rpx; color: #75685e; font-size: 19rpx; }

@media (max-width: 360px) {
  .login-panel { padding-right: 24rpx; padding-left: 24rpx; }
  .login-title { font-size: 46rpx; }
}
