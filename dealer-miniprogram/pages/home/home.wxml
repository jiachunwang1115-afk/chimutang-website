<view class="page">
  <view class="home-head">
    <view class="home-copy">
      <text class="eyebrow">WOOD ALL · DEALER</text>
      <text class="page-title">{{greeting}}</text>
      <text class="page-subtitle">从产品配置到项目金额，一步完成专业报价。</text>
    </view>
    <image src="/assets/logo.png" mode="aspectFit"></image>
  </view>

  <view class="mode-note">
    <text class="connection-state {{localMode ? 'is-local' : ''}}">{{statusText}}</text>
    <text>{{localMode ? '仅保存在当前手机' : '已接入总部账号'}}</text>
  </view>

  <view class="home-total">
    <text>累计报价</text>
    <text class="money">{{totalAmount}}</text>
    <view class="home-metrics">
      <view><text>{{quoteCount}}</text><text>报价项目</text></view>
      <view><text>{{totalArea}} m²</text><text>累计计价面积</text></view>
    </view>
  </view>

  <view class="home-actions">
    <button class="new-quote" bindtap="newQuote">
      <view><text class="action-title">新建私定报价</text><text class="action-copy">填写项目，选择产品，核算金额</text></view>
      <text class="action-arrow">＋</text>
    </button>
    <button class="history-link" bindtap="goHistory"><view><text>历史报价</text><text>{{quoteCount}} 份项目记录</text></view><text>→</text></button>
  </view>

  <view class="section">
    <view class="section-head"><text>最近报价</text><text bindtap="goHistory">查看全部</text></view>
    <view wx:if="{{quotes.length}}">
      <view class="quote-row" wx:for="{{quotes}}" wx:key="id" data-id="{{item.id}}" bindtap="editQuote">
        <view class="quote-main"><text>{{item.projectName || item.title}}</text><text>{{item.dealerName || user.displayName}} · {{item.city || '城市待补充'}}</text></view>
        <view class="quote-value"><text class="money">{{item.amountText}}</text><text>{{item.dateText}}</text></view>
      </view>
    </view>
    <view class="empty" wx:else>暂无报价，从新建项目开始。</view>
  </view>

  <view class="bottom-nav">
    <view class="nav-item is-active"><text class="nav-symbol">⌂</text><text>首页</text></view>
    <view class="nav-item" bindtap="newQuote"><text class="nav-symbol">＋</text><text>报价</text></view>
    <view class="nav-item" bindtap="goHistory"><text class="nav-symbol">≡</text><text>历史</text></view>
    <view class="nav-item" bindtap="goProfile"><text class="nav-symbol">○</text><text>我的</text></view>
  </view>
</view>
