.profile-card { display: grid; width: 100%; grid-template-columns: 78rpx minmax(0, 1fr) auto; align-items: center; gap: 16rpx; border-bottom: 1rpx solid #d9d2cb; padding: 18rpx 0 24rpx; }
.profile-card image { width: 78rpx; height: 66rpx; }
.profile-card view { display: grid; gap: 6rpx; }
.profile-card view text:first-child { font-size: 25rpx; font-weight: 700; }
.profile-card view text:last-child { color: #75685e; font-size: 18rpx; }
.profile-card > text { grid-column: auto; justify-self: end; border: 1rpx solid #c8b8a8; border-radius: 3rpx; padding: 6rpx 10rpx; color: #5b3928; font-size: 16rpx; }
.profile-list { margin-top: 18rpx; border-top: 1rpx solid #d9d2cb; }
.profile-list view { display: grid; width: 100%; min-height: 78rpx; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 18rpx; border-bottom: 1rpx solid #d9d2cb; font-size: 21rpx; }
.profile-list view text:last-child { max-width: 390rpx; color: #75685e; font-size: 18rpx; text-align: right; overflow-wrap: anywhere; }
.logout { width: 100%; margin-top: 28rpx; }
