<view class="page">
  <view class="profile-card">
    <image src="/assets/logo.png" mode="aspectFit"></image>
    <view><text>{{user.displayName}}</text><text>{{user.username}}</text></view>
    <text>{{localMode ? '本机体验' : (user.role === 'admin' ? '总部管理员' : '经销商')}}</text>
  </view>
  <view class="profile-list">
    <view><text>数据状态</text><text>{{syncText}}</text></view>
    <view bindtap="copyWebsite"><text>网页版报价</text><text>复制访问地址 ›</text></view>
  </view>
  <button class="outline-button logout" bindtap="logout">{{localMode ? '退出体验模式' : '退出当前账号'}}</button>
  <view class="bottom-nav">
    <view class="nav-item" bindtap="goHome"><text class="nav-symbol">⌂</text><text>首页</text></view>
    <view class="nav-item" bindtap="newQuote"><text class="nav-symbol">＋</text><text>报价</text></view>
    <view class="nav-item" bindtap="goHistory"><text class="nav-symbol">≡</text><text>历史</text></view>
    <view class="nav-item is-active"><text class="nav-symbol">○</text><text>我的</text></view>
  </view>
</view>
