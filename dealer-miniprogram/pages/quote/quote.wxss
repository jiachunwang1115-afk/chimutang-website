.quote-page { width: 100%; min-height: 100vh; padding: 26rpx 24rpx 158rpx; background: #f5f0e8; overflow-x: hidden; }
.quote-heading { position: relative; padding: 6rpx 4rpx 26rpx; }
.quote-heading .page-title { display: block; }
.save-state { position: absolute; right: 4rpx; bottom: 30rpx; color: #75685e; font-size: 19rpx; }
.local-strip { margin: 0 0 22rpx; border-left: 4rpx solid #9a6741; padding: 16rpx 20rpx; background: #fffdf9; color: #75685e; font-size: 20rpx; }
.quote-steps { position: sticky; z-index: 25; top: 0; display: grid; width: 100%; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rpx; margin-bottom: 18rpx; border: 1rpx solid #d9cec1; padding: 6rpx; background: rgba(245, 240, 232, .98); }
.quote-steps button { min-width: 0; min-height: 62rpx; margin: 0; border: 0; border-radius: 3rpx; padding: 0; background: transparent; color: #5b3928; font-size: 20rpx; font-weight: 700; line-height: 62rpx; }
.quote-steps button:active { background: #e9ded2; }
.quote-section, .quote-summary { scroll-margin-top: 86rpx; }
.quote-section { margin-bottom: 22rpx; border: 1rpx solid #d9cec1; border-radius: 6rpx; background: #fffdf9; overflow: hidden; }
.quote-section-title { display: flex; min-height: 86rpx; align-items: center; justify-content: space-between; gap: 16rpx; border-bottom: 1rpx solid #d9cec1; padding: 0 20rpx; }
.quote-section-title > view { display: flex; align-items: center; gap: 16rpx; }
.quote-section-title > view > text { color: #9a6741; font-family: Georgia, serif; font-size: 20rpx; }
.quote-section-title .section-name { color: #2e251f; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 27rpx; font-weight: 700; }
.quote-section-title button { min-height: 58rpx; margin: 0; border: 1rpx solid #c8b8a8; border-radius: 5rpx; padding: 0 18rpx; background: transparent; color: #5b3928; font-size: 20rpx; line-height: 58rpx; }
.quote-section-title .voice-entry { display: flex; align-items: center; gap: 10rpx; border-color: #8f6547; background: #5b3928; color: #fff; }
.voice-entry-icon { position: relative; display: block; width: 13rpx; height: 20rpx; border: 2rpx solid currentColor; border-radius: 8rpx; }
.voice-entry-icon::before { position: absolute; top: 12rpx; left: -6rpx; width: 21rpx; height: 12rpx; border-right: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; border-left: 2rpx solid currentColor; border-radius: 0 0 12rpx 12rpx; content: ""; }
.voice-entry-icon::after { position: absolute; top: 25rpx; left: 5rpx; width: 2rpx; height: 5rpx; background: currentColor; content: ""; }
.quote-section > .field, .quote-section > .field-row, .quote-section > .number-grid { margin-inline: 20rpx; }
.section-grid { margin-inline: 20rpx; }
.section-field { margin-inline: 20rpx; }
.field-heading { display: flex; min-height: 48rpx; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 8rpx; }
.field-heading .field-label { min-width: 0; margin-bottom: 0; }
.field-heading button { min-height: 48rpx; margin: 0; border: 0; padding: 0 2rpx 0 18rpx; background: transparent; color: #8b6549; font-size: 19rpx; line-height: 48rpx; }
.field-row { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0; }
.number-grid, .section-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.line-card { border-bottom: 1rpx solid #d9cec1; padding: 0 20rpx 28rpx; }
.line-card:last-child { border-bottom: 0; }
.line-head { display: flex; min-height: 72rpx; align-items: center; justify-content: space-between; }
.line-head > text { color: #75685e; font-size: 20rpx; }
.line-tools { display: flex; align-items: center; gap: 4rpx; }
.line-tools button { display: flex; width: 52rpx; min-height: 52rpx; align-items: center; justify-content: center; margin: 0; border: 0; padding: 0; background: transparent; color: #5b3928; font-size: 24rpx; line-height: 52rpx; }
.line-tools .delete-line { width: auto; padding-left: 14rpx; color: #9a352d; font-size: 19rpx; }
.room-field { margin-top: 0; }
.product-select { display: grid; width: 100%; grid-template-columns: 96rpx minmax(0, 1fr) auto; min-height: 118rpx; align-items: center; gap: 15rpx; margin-top: 20rpx; border: 1rpx solid #c8b8a8; border-radius: 6rpx; padding: 12rpx; background: #f8f3ed; }
.product-select image, .product-placeholder { width: 96rpx; height: 88rpx; border-radius: 4rpx; }
.product-placeholder { display: flex; align-items: center; justify-content: center; background: #e6ddd2; color: #8d7969; font-family: Georgia, serif; font-size: 17rpx; letter-spacing: 2rpx; }
.product-selected-copy { display: grid; gap: 8rpx; min-width: 0; }
.product-selected-copy text { overflow: hidden; color: #75685e; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.product-selected-copy text:first-child { color: #2e251f; font-size: 23rpx; font-weight: 700; }
.product-selected-copy text:last-child { color: #9a6741; font-size: 17rpx; }
.select-command { color: #5b3928; font-size: 20rpx; font-weight: 700; }
.number-grid .field { min-width: 0; }
.number-grid .field-input { padding-inline: 16rpx; }
.billable { display: flex; min-height: 116rpx; align-self: end; flex-direction: column; justify-content: center; gap: 8rpx; border: 1rpx solid #d9cec1; border-radius: 6rpx; padding: 0 18rpx; background: #f5f0e8; }
.billable text { color: #75685e; font-size: 18rpx; }
.billable .billable-value { color: #2e251f; font-size: 24rpx; font-weight: 700; }
.terms-input { min-height: 190rpx; margin-bottom: 26rpx; }
.quote-summary { margin-top: 28rpx; border-block: 1rpx solid #d9cec1; padding: 16rpx 6rpx 20rpx; }
.summary-heading { justify-content: flex-start !important; gap: 16rpx; min-height: 78rpx !important; color: #2e251f !important; font-size: 27rpx !important; font-weight: 700; }
.summary-heading text:first-child { color: #9a6741; font-family: Georgia, serif; font-size: 20rpx; font-weight: 400; }
.quote-summary > view { display: flex; min-height: 58rpx; align-items: center; justify-content: space-between; color: #75685e; font-size: 21rpx; }
.quote-summary .summary-value { color: #2e251f; font-weight: 700; }
.quote-summary .summary-total { min-height: 88rpx; border-top: 1rpx solid #d9cec1; color: #2e251f; font-size: 25rpx; }
.quote-summary .summary-total .summary-value { font-size: 38rpx; }
.quote-actionbar { position: fixed; z-index: 30; right: 0; bottom: 0; left: 0; display: grid; width: 100%; grid-template-columns: minmax(0, 1fr) minmax(190rpx, 220rpx); gap: 16rpx; min-height: calc(112rpx + env(safe-area-inset-bottom)); align-items: center; border-top: 1rpx solid #d9cec1; padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom)); background: rgba(251, 248, 242, .98); overflow: hidden; }
.quote-actionbar > view { display: grid; min-width: 0; gap: 5rpx; }
.quote-actionbar text { color: #75685e; font-size: 18rpx; }
.quote-actionbar .action-total { overflow: hidden; font-size: 31rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.quote-actionbar button { width: 100%; min-width: 0; min-height: 84rpx; margin: 0; border-radius: 5rpx; background: #5b3928; color: #fff; font-size: 24rpx; font-weight: 700; line-height: 84rpx; }
.product-picker-mask { position: fixed; z-index: 100; inset: 0; display: flex; align-items: flex-end; background: rgba(39, 29, 23, .56); }
.product-picker { display: flex; width: 100%; height: 88vh; max-height: 1180rpx; flex-direction: column; border-radius: 8rpx 8rpx 0 0; padding-bottom: env(safe-area-inset-bottom); background: #fbf8f2; overflow: hidden; }
.picker-head { display: flex; min-height: 108rpx; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #d9cec1; padding: 18rpx 24rpx; }
.picker-head > view { display: grid; gap: 8rpx; }
.picker-head > view > text:last-child { font-size: 30rpx; font-weight: 700; }
.picker-head button { display: flex; width: 68rpx; height: 68rpx; align-items: center; justify-content: center; margin: 0; border: 0; background: transparent; color: #5b3928; font-size: 42rpx; font-weight: 300; line-height: 68rpx; }
.picker-search { display: flex; height: 84rpx; align-items: center; gap: 12rpx; margin: 20rpx 24rpx 12rpx; border: 1rpx solid #c8b8a8; border-radius: 6rpx; padding: 0 20rpx; background: #fff; }
.picker-search > text { color: #75685e; font-size: 28rpx; }
.picker-search input { min-width: 0; flex: 1; font-size: 27rpx; }
.series-filter { width: 100%; min-height: 72rpx; border-bottom: 1rpx solid #d9cec1; white-space: nowrap; }
.series-filter-inner { display: inline-flex; gap: 10rpx; padding: 4rpx 24rpx 14rpx; }
.series-filter button { min-height: 54rpx; margin: 0; border: 1rpx solid #c8b8a8; border-radius: 4rpx; padding: 0 20rpx; background: transparent; color: #75685e; font-size: 20rpx; line-height: 54rpx; }
.series-filter button.is-active { border-color: #5b3928; background: #5b3928; color: #fff; }
.product-list { min-height: 0; flex: 1; }
.product-option { display: grid; width: 100%; grid-template-columns: 116rpx minmax(0, 1fr) auto; min-height: 136rpx; align-items: center; gap: 16rpx; border-bottom: 1rpx solid #e2d8cd; padding: 16rpx 24rpx; background: #fffdf9; }
.product-option image { width: 116rpx; height: 98rpx; border-radius: 4rpx; background: #e6ddd2; }
.product-option-copy { display: grid; gap: 8rpx; min-width: 0; }
.product-option-copy text { overflow: hidden; color: #75685e; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.product-option-copy text:first-child { color: #2e251f; font-size: 23rpx; font-weight: 700; }
.product-option-copy text:last-child { color: #9a6741; font-size: 17rpx; }
.copy-picker-mask { position: fixed; z-index: 110; inset: 0; display: flex; align-items: flex-end; background: rgba(39, 29, 23, .56); }
.copy-picker { display: flex; width: 100%; height: 76vh; max-height: 1040rpx; flex-direction: column; border-radius: 8rpx 8rpx 0 0; padding-bottom: calc(18rpx + env(safe-area-inset-bottom)); background: #fbf8f2; overflow: hidden; }
.copy-picker-head { display: flex; min-height: 104rpx; align-items: center; justify-content: space-between; gap: 18rpx; border-bottom: 1rpx solid #d9cec1; padding: 18rpx 24rpx; }
.copy-picker-head > view { display: grid; min-width: 0; gap: 7rpx; }
.copy-picker-head > view > text:last-child { font-size: 29rpx; font-weight: 700; }
.copy-picker-head > button { display: flex; width: 64rpx; height: 64rpx; flex: none; align-items: center; justify-content: center; margin: 0; border: 0; padding: 0; background: transparent; color: #5b3928; font-size: 40rpx; font-weight: 300; line-height: 64rpx; }
.copy-list { min-height: 0; flex: 1; }
.copy-option { display: grid; width: 100%; grid-template-columns: minmax(0, 1fr) 86rpx; align-items: center; gap: 18rpx; border-bottom: 1rpx solid #e2d8cd; padding: 22rpx 24rpx; background: #fffdf9; }
.copy-option > view { display: grid; min-width: 0; gap: 8rpx; }
.copy-option > view text:first-child { color: #2e251f; font-size: 23rpx; font-weight: 700; }
.copy-option > view text:last-child { color: #75685e; font-size: 20rpx; line-height: 1.65; }
.copy-option > button { width: 86rpx; min-height: 58rpx; margin: 0; border: 1rpx solid #bfae9f; border-radius: 4rpx; padding: 0; background: transparent; color: #5b3928; font-size: 20rpx; line-height: 58rpx; }
.copy-done { width: calc(100% - 48rpx); min-height: 78rpx; margin: 16rpx 24rpx 0; border-radius: 5rpx; background: #5b3928; color: #fff; font-size: 23rpx; font-weight: 700; line-height: 78rpx; }
.voice-sheet-mask { position: fixed; z-index: 120; inset: 0; display: flex; align-items: flex-end; background: rgba(39, 29, 23, .6); }
.voice-sheet { display: flex; width: 100%; height: 92vh; max-height: 1320rpx; flex-direction: column; padding-bottom: env(safe-area-inset-bottom); background: #fbf8f2; overflow: hidden; }
.voice-sheet-head { display: flex; min-height: 106rpx; flex: none; align-items: center; justify-content: space-between; gap: 18rpx; border-bottom: 1rpx solid #d9cec1; padding: 18rpx 24rpx; }
.voice-sheet-head > view { display: grid; gap: 7rpx; }
.voice-sheet-head > view > text:last-child { color: #2e251f; font-size: 29rpx; font-weight: 700; }
.voice-sheet-head > button { display: flex; width: 64rpx; height: 64rpx; flex: none; align-items: center; justify-content: center; margin: 0; border: 0; padding: 0; background: transparent; color: #5b3928; font-size: 40rpx; font-weight: 300; line-height: 64rpx; }
.voice-guide { display: grid; flex: none; gap: 8rpx; border-bottom: 1rpx solid #e2d8cd; padding: 18rpx 24rpx; background: #f3ece3; }
.voice-guide text:first-child { color: #2e251f; font-size: 21rpx; font-weight: 700; }
.voice-guide text:last-child { color: #75685e; font-size: 18rpx; line-height: 1.55; }
.voice-control { display: grid; flex: none; justify-items: center; gap: 12rpx; padding: 22rpx 24rpx 16rpx; }
.voice-control > button { display: flex; width: min(100%, 420rpx); min-height: 82rpx; align-items: center; justify-content: center; gap: 18rpx; margin: 0; border: 1rpx solid #5b3928; border-radius: 5rpx; background: #5b3928; color: #fff; font-size: 24rpx; font-weight: 700; line-height: 82rpx; }
.voice-control > button.is-recording { border-color: #9a352d; background: #9a352d; }
.voice-control > button[disabled] { border-color: #c6b8ad; background: #c6b8ad; color: #fff; opacity: 1; }
.voice-control > text { color: #75685e; font-size: 18rpx; line-height: 1.5; text-align: center; }
.microphone { position: relative; width: 22rpx; height: 30rpx; border: 3rpx solid currentColor; border-radius: 13rpx; }
.microphone::before { position: absolute; top: 17rpx; left: -9rpx; width: 34rpx; height: 20rpx; border-right: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; border-left: 3rpx solid currentColor; border-radius: 0 0 20rpx 20rpx; content: ""; }
.microphone::after { position: absolute; top: 37rpx; left: 9rpx; width: 3rpx; height: 8rpx; background: currentColor; content: ""; }
.microphone text { position: absolute; top: 44rpx; left: 3rpx; width: 16rpx; height: 3rpx; background: currentColor; }
.voice-transcript { flex: none; border-block: 1rpx solid #e2d8cd; padding: 14rpx 24rpx 18rpx; background: #fffdf9; }
.voice-transcript > view { display: flex; min-height: 46rpx; align-items: center; justify-content: space-between; }
.voice-transcript > view > text { color: #2e251f; font-size: 20rpx; font-weight: 700; }
.voice-transcript > view > button { min-height: 46rpx; margin: 0; border: 0; padding: 0; background: transparent; color: #8b6549; font-size: 19rpx; line-height: 46rpx; }
.voice-transcript textarea { width: 100%; height: 112rpx; border: 1rpx solid #d9cec1; border-radius: 5rpx; padding: 14rpx 16rpx; background: #fff; color: #2e251f; font-size: 21rpx; line-height: 1.6; }
.voice-review { min-height: 0; flex: 1; background: #fbf8f2; }
.voice-review-empty { display: grid; justify-items: center; gap: 10rpx; padding: 48rpx 28rpx; color: #75685e; font-size: 20rpx; line-height: 1.6; text-align: center; }
.voice-review-group { border-bottom: 1rpx solid #e2d8cd; padding: 20rpx 24rpx; background: #fffdf9; }
.voice-review-title { display: block; margin-bottom: 12rpx; color: #9a6741; font-size: 18rpx; font-weight: 700; }
.voice-review-row { display: grid; grid-template-columns: 150rpx minmax(0, 1fr); gap: 18rpx; padding: 10rpx 0; }
.voice-review-row text { color: #75685e; font-size: 20rpx; line-height: 1.55; }
.voice-review-row text:last-child { color: #2e251f; }
.voice-line-preview { display: grid; gap: 12rpx; border-top: 1rpx solid #eee5db; padding: 16rpx 0; }
.voice-line-preview:first-of-type { border-top: 0; }
.voice-line-preview > view { display: flex; min-width: 0; align-items: center; justify-content: space-between; gap: 14rpx; }
.voice-line-preview > view:first-child text:first-child { flex: none; color: #2e251f; font-size: 22rpx; font-weight: 700; }
.voice-line-preview > view:first-child text:last-child { min-width: 0; overflow: hidden; color: #75685e; font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.voice-line-preview > view:last-child { justify-content: flex-start; color: #8b6549; font-size: 18rpx; }
.voice-warnings { display: grid; gap: 8rpx; border-left: 4rpx solid #aa5b3e; margin: 18rpx 24rpx; padding: 14rpx 18rpx; background: #f5e9df; }
.voice-warnings text { color: #7e4633; font-size: 18rpx; line-height: 1.5; }
.voice-warnings text:first-child { color: #5e3326; font-size: 19rpx; font-weight: 700; }
.voice-actions { display: grid; grid-template-columns: 1fr 1.5fr; gap: 14rpx; flex: none; border-top: 1rpx solid #d9cec1; padding: 14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom)); background: #fbf8f2; }
.voice-actions button { width: 100%; min-height: 78rpx; margin: 0; border: 1rpx solid #bfae9f; border-radius: 5rpx; background: transparent; color: #5b3928; font-size: 22rpx; font-weight: 700; line-height: 78rpx; }
.voice-actions .voice-apply { border-color: #5b3928; background: #5b3928; color: #fff; }
.voice-actions .voice-apply[disabled] { border-color: #c6b8ad; background: #c6b8ad; color: #fff; opacity: 1; }

@media (max-width: 360px) {
  .quote-page { padding-right: 18rpx; padding-left: 18rpx; }
  .number-grid, .section-grid { grid-template-columns: minmax(0, 1fr); gap: 0; }
  .product-select { grid-template-columns: 84rpx minmax(0, 1fr) auto; gap: 12rpx; }
  .product-select image, .product-placeholder { width: 84rpx; height: 80rpx; }
  .quote-actionbar { grid-template-columns: minmax(0, 1fr) 188rpx; padding-right: 18rpx; padding-left: 18rpx; }
  .quote-section-title .voice-entry { padding-inline: 12rpx; }
  .voice-review-row { grid-template-columns: 128rpx minmax(0, 1fr); }
}
