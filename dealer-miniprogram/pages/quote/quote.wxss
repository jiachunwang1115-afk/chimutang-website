.quote-page { width: 100%; min-height: 100vh; padding: 14rpx 22rpx 142rpx; background: #f7f5f1; overflow-x: hidden; }
.quote-context { display: flex; min-height: 52rpx; align-items: center; justify-content: space-between; gap: 18rpx; padding: 0 2rpx; }
.quote-context > text:first-child { min-width: 0; overflow: hidden; color: #2e251f; font-size: 22rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.save-state { flex: none; color: #81766d; font-size: 18rpx; }
.local-strip { margin: 0 2rpx 8rpx; padding: 8rpx 0 12rpx; color: #8b6549; font-size: 18rpx; }
.quote-steps { position: sticky; z-index: 25; top: 0; display: grid; width: calc(100% + 44rpx); grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 0 -22rpx 12rpx; border-block: 1rpx solid #ddd6cf; padding: 4rpx 22rpx; background: rgba(247, 245, 241, .98); }
.quote-steps button { min-width: 0; min-height: 52rpx; margin: 0; border: 0; border-radius: 2rpx; padding: 0; background: transparent; color: #6a5346; font-size: 18rpx; font-weight: 600; line-height: 52rpx; }
.quote-steps button:active { background: #ece6df; }
.quote-section, .quote-summary { scroll-margin-top: 72rpx; }
.quote-section { margin-bottom: 30rpx; border-top: 1rpx solid #d9d2cb; background: transparent; }
.quote-section-title { display: flex; min-height: 72rpx; align-items: center; justify-content: space-between; gap: 16rpx; padding: 0 2rpx; }
.quote-section-title > view { display: flex; align-items: center; gap: 16rpx; }
.quote-section-title > view > text { color: #9a6741; font-family: Georgia, serif; font-size: 18rpx; }
.quote-section-title .section-name { color: #2e251f; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 25rpx; font-weight: 700; }
.quote-section-title button { min-height: 48rpx; margin: 0; border: 0; border-radius: 3rpx; padding: 0 10rpx; background: transparent; color: #6b4632; font-size: 19rpx; line-height: 48rpx; }
.quote-section > .field, .quote-section > .field-row, .quote-section > .number-grid { margin-inline: 0; }
.section-grid { margin-inline: 0; }
.section-field { margin-inline: 0; }
.field-heading { display: flex; min-height: 42rpx; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 6rpx; }
.field-heading .field-label { min-width: 0; margin-bottom: 0; }
.field-heading button { min-height: 42rpx; margin: 0; border: 0; padding: 0 2rpx 0 16rpx; background: transparent; color: #8b6549; font-size: 18rpx; line-height: 42rpx; }
.voice-field-control { position: relative; width: 100%; }
.voice-field-control .field-input, .voice-field-control .field-textarea { padding-right: 72rpx; }
.field-mic { position: absolute; z-index: 2; top: 13rpx; right: 13rpx; display: flex; width: 52rpx; height: 52rpx; align-items: center; justify-content: center; border: 1rpx solid #d8c9bb; border-radius: 50%; background: #fff; color: #76523e; }
.field-mic-hover { border-color: #bda995; background: #f3ebe2; }
.field-mic.is-active { border-color: #8d3c32; background: #8d3c32; color: #fff; }
.field-mic.is-active::before { position: absolute; inset: -5rpx; border: 2rpx solid rgba(141, 60, 50, .35); border-radius: 50%; content: ""; animation: voice-pulse 1s ease-in-out infinite; }
.field-mic-icon { position: relative; display: block; width: 12rpx; height: 19rpx; border: 2rpx solid currentColor; border-radius: 7rpx; }
.field-mic-icon::before { position: absolute; top: 11rpx; left: -6rpx; width: 20rpx; height: 12rpx; border-right: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; border-left: 2rpx solid currentColor; border-radius: 0 0 11rpx 11rpx; content: ""; }
.field-mic-icon::after { position: absolute; top: 25rpx; left: 1rpx; width: 10rpx; height: 2rpx; background: currentColor; content: ""; }
.voice-textarea-control .field-mic { top: 12rpx; }
@keyframes voice-pulse {
  0%, 100% { opacity: .45; transform: scale(.95); }
  50% { opacity: 1; transform: scale(1.05); }
}
.field-row { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0; }
.number-grid, .section-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; }
.line-card { border-bottom: 1rpx solid #d9d2cb; padding: 0 2rpx 24rpx; }
.line-card:last-child { border-bottom: 0; }
.line-head { display: flex; min-height: 62rpx; align-items: center; justify-content: space-between; }
.line-head > text { color: #75685e; font-size: 20rpx; }
.line-tools { display: flex; align-items: center; gap: 4rpx; }
.line-tools button { display: flex; width: 46rpx; min-height: 46rpx; align-items: center; justify-content: center; margin: 0; border: 0; padding: 0; background: transparent; color: #5b3928; font-size: 22rpx; line-height: 46rpx; }
.line-tools .delete-line { width: auto; padding-left: 14rpx; color: #9a352d; font-size: 19rpx; }
.room-field { margin-top: 0; }
.product-select { display: grid; width: 100%; grid-template-columns: 88rpx minmax(0, 1fr) auto; min-height: 104rpx; align-items: center; gap: 14rpx; margin-top: 16rpx; border: 1rpx solid #d8d0c7; border-radius: 4rpx; padding: 10rpx; background: #fff; }
.product-select image, .product-placeholder { width: 88rpx; height: 78rpx; border-radius: 3rpx; }
.product-placeholder { display: flex; align-items: center; justify-content: center; background: #e6ddd2; color: #8d7969; font-family: Georgia, serif; font-size: 17rpx; letter-spacing: 0; }
.product-selected-copy { display: grid; gap: 8rpx; min-width: 0; }
.product-selected-copy text { overflow: hidden; color: #75685e; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.product-selected-copy text:first-child { color: #2e251f; font-size: 23rpx; font-weight: 700; }
.product-selected-copy text:last-child { color: #9a6741; font-size: 17rpx; }
.select-command { color: #5b3928; font-size: 20rpx; font-weight: 700; }
.number-grid .field { min-width: 0; }
.number-grid .field-input { padding-inline: 16rpx; }
.billable { display: flex; min-height: 104rpx; align-self: end; flex-direction: column; justify-content: center; gap: 6rpx; border: 1rpx solid #d8d0c7; border-radius: 4rpx; padding: 0 16rpx; background: #f1eee9; }
.billable text { color: #75685e; font-size: 18rpx; }
.billable .billable-value { color: #2e251f; font-size: 24rpx; font-weight: 700; }
.terms-input { min-height: 154rpx; margin-bottom: 12rpx; }
.quote-summary { margin-top: 8rpx; border-block: 1rpx solid #d9d2cb; padding: 10rpx 2rpx 16rpx; }
.summary-heading { justify-content: flex-start !important; gap: 16rpx; min-height: 78rpx !important; color: #2e251f !important; font-size: 27rpx !important; font-weight: 700; }
.summary-heading text:first-child { color: #9a6741; font-family: Georgia, serif; font-size: 20rpx; font-weight: 400; }
.quote-summary > view { display: flex; min-height: 52rpx; align-items: center; justify-content: space-between; color: #75685e; font-size: 20rpx; }
.quote-summary .summary-value { color: #2e251f; font-weight: 700; }
.quote-summary .summary-total { min-height: 78rpx; border-top: 1rpx solid #d9d2cb; color: #2e251f; font-size: 23rpx; }
.quote-summary .summary-total .summary-value { font-size: 34rpx; }
.export-panel { margin-top: 24rpx; border: 1rpx solid #d9d2cb; border-radius: 4rpx; padding: 22rpx 20rpx 20rpx; background: #fffdf9; }
.export-copy { display: grid; gap: 7rpx; }
.export-copy > text:first-child { color: #2e251f; font-size: 23rpx; font-weight: 700; }
.export-copy > text:last-child { color: #75685e; font-size: 18rpx; line-height: 1.5; }
.export-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin-top: 18rpx; }
.export-button { display: flex; min-height: 66rpx; align-items: center; justify-content: center; gap: 10rpx; margin: 0; border: 1rpx solid #bfae9f; border-radius: 4rpx; padding: 0 16rpx; background: transparent; color: #5b3928; font-size: 19rpx; line-height: 66rpx; }
.export-button:active { background: #f2ece4; }
.export-button .export-type { font-family: Georgia, "Times New Roman", serif; font-size: 20rpx; font-weight: 700; }
.export-note { display: block; margin-top: 14rpx; color: #8a7f76; font-size: 16rpx; line-height: 1.5; }
.quote-export-canvas { position: fixed; z-index: -1; top: -10000px; left: -10000px; opacity: 0; pointer-events: none; }
.quote-export-canvas-desktop { width: 1280px; height: 720px; }
.quote-export-canvas-mobile { width: 900px; height: 1600px; }
.quote-actionbar { position: fixed; z-index: 30; right: 0; bottom: 0; left: 0; display: grid; width: 100%; grid-template-columns: minmax(0, 1fr) minmax(176rpx, 206rpx); gap: 14rpx; min-height: calc(98rpx + env(safe-area-inset-bottom)); align-items: center; border-top: 1rpx solid #ddd6cf; padding: 10rpx 22rpx calc(10rpx + env(safe-area-inset-bottom)); background: rgba(255, 255, 255, .98); overflow: hidden; }
.quote-actionbar > view { display: grid; min-width: 0; gap: 5rpx; }
.quote-actionbar text { color: #75685e; font-size: 18rpx; }
.quote-actionbar .action-total { overflow: hidden; font-size: 28rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.quote-actionbar button { width: 100%; min-width: 0; min-height: 72rpx; margin: 0; border-radius: 4rpx; background: #5b3928; color: #fff; font-size: 22rpx; font-weight: 700; line-height: 72rpx; }
.product-picker-mask { position: fixed; z-index: 100; inset: 0; display: flex; align-items: flex-end; background: rgba(39, 29, 23, .56); }
.product-picker { display: flex; width: 100%; height: 88vh; max-height: 1180rpx; flex-direction: column; border-radius: 8rpx 8rpx 0 0; padding-bottom: env(safe-area-inset-bottom); background: #fbf8f2; overflow: hidden; }
.picker-head { display: flex; min-height: 108rpx; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #d9cec1; padding: 18rpx 24rpx; }
.picker-head > view { display: grid; gap: 8rpx; }
.picker-head > view > text:last-child { font-size: 30rpx; font-weight: 700; }
.picker-head button { display: flex; width: 68rpx; height: 68rpx; align-items: center; justify-content: center; margin: 0; border: 0; background: transparent; color: #5b3928; font-size: 42rpx; font-weight: 300; line-height: 68rpx; }
.picker-search { display: flex; height: 84rpx; align-items: center; gap: 12rpx; margin: 20rpx 24rpx 12rpx; border: 1rpx solid #c8b8a8; border-radius: 6rpx; padding: 0 20rpx; background: #fff; }
.picker-search > text { color: #75685e; font-size: 28rpx; }
.picker-search input { min-width: 0; flex: 1; font-size: 27rpx; }
.series-filter { width: 100%; min-height: 72rpx; border-bottom: 1rpx solid #d9cec1; white-space: nowrap; }
.series-filter-inner { display: inline-flex; gap: 10rpx; padding: 4rpx 24rpx 14rpx; }
.series-filter button { min-height: 54rpx; margin: 0; border: 1rpx solid #c8b8a8; border-radius: 4rpx; padding: 0 20rpx; background: transparent; color: #75685e; font-size: 20rpx; line-height: 54rpx; }
.series-filter button.is-active { border-color: #5b3928; background: #5b3928; color: #fff; }
.product-list { min-height: 0; flex: 1; }
.product-option { display: grid; width: 100%; grid-template-columns: 116rpx minmax(0, 1fr) auto; min-height: 136rpx; align-items: center; gap: 16rpx; border-bottom: 1rpx solid #e2d8cd; padding: 16rpx 24rpx; background: #fffdf9; }
.product-option image { width: 116rpx; height: 98rpx; border-radius: 4rpx; background: #e6ddd2; }
.product-option-copy { display: grid; gap: 8rpx; min-width: 0; }
.product-option-copy text { overflow: hidden; color: #75685e; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.product-option-copy text:first-child { color: #2e251f; font-size: 23rpx; font-weight: 700; }
.product-option-copy text:last-child { color: #9a6741; font-size: 17rpx; }
.copy-picker-mask { position: fixed; z-index: 110; inset: 0; display: flex; align-items: flex-end; background: rgba(39, 29, 23, .56); }
.copy-picker { display: flex; width: 100%; height: 76vh; max-height: 1040rpx; flex-direction: column; border-radius: 8rpx 8rpx 0 0; padding-bottom: calc(18rpx + env(safe-area-inset-bottom)); background: #fbf8f2; overflow: hidden; }
.copy-picker-head { display: flex; min-height: 104rpx; align-items: center; justify-content: space-between; gap: 18rpx; border-bottom: 1rpx solid #d9cec1; padding: 18rpx 24rpx; }
.copy-picker-head > view { display: grid; min-width: 0; gap: 7rpx; }
.copy-picker-head > view > text:last-child { font-size: 29rpx; font-weight: 700; }
.copy-picker-head > button { display: flex; width: 64rpx; height: 64rpx; flex: none; align-items: center; justify-content: center; margin: 0; border: 0; padding: 0; background: transparent; color: #5b3928; font-size: 40rpx; font-weight: 300; line-height: 64rpx; }
.copy-list { min-height: 0; flex: 1; }
.copy-option { display: grid; width: 100%; grid-template-columns: minmax(0, 1fr) 86rpx; align-items: center; gap: 18rpx; border-bottom: 1rpx solid #e2d8cd; padding: 22rpx 24rpx; background: #fffdf9; }
.copy-option > view { display: grid; min-width: 0; gap: 8rpx; }
.copy-option > view text:first-child { color: #2e251f; font-size: 23rpx; font-weight: 700; }
.copy-option > view text:last-child { color: #75685e; font-size: 20rpx; line-height: 1.65; }
.copy-option > button { width: 86rpx; min-height: 58rpx; margin: 0; border: 1rpx solid #bfae9f; border-radius: 4rpx; padding: 0; background: transparent; color: #5b3928; font-size: 20rpx; line-height: 58rpx; }
.copy-done { width: calc(100% - 48rpx); min-height: 78rpx; margin: 16rpx 24rpx 0; border-radius: 5rpx; background: #5b3928; color: #fff; font-size: 23rpx; font-weight: 700; line-height: 78rpx; }

@media (max-width: 360px) {
  .quote-page { padding-right: 18rpx; padding-left: 18rpx; }
  .quote-steps { width: calc(100% + 36rpx); margin-right: -18rpx; margin-left: -18rpx; padding-right: 18rpx; padding-left: 18rpx; }
  .number-grid, .section-grid { grid-template-columns: minmax(0, 1fr); gap: 0; }
  .product-select { grid-template-columns: 84rpx minmax(0, 1fr) auto; gap: 12rpx; }
  .product-select image, .product-placeholder { width: 84rpx; height: 80rpx; }
  .quote-actionbar { grid-template-columns: minmax(0, 1fr) 176rpx; padding-right: 18rpx; padding-left: 18rpx; }
  .field-mic { right: 12rpx; width: 50rpx; height: 50rpx; }
}
